    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/websockets": "^11.1.6",
    "@sentry/nestjs": "^10.42.0",
    "@sparticuz/chromium": "^131.0.1",
    "@types/ssh2": "^1.15.5",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "ai-recruit": ".",
    "axios": "^1.12.2",
    "bloom-filters": "^3.0.4",
    "bull": "^4.16.5",
    "bullmq": "^5.70.4",
    "cache-manager": "^7.2.8",
    "cache-manager-redis-yet": "^5.1.5",
    "casbin": "^5.38.0",
    "casbin-file-adapter": "^1.0.1",
    "casbin-pg-adapter": "^1.4.0",
