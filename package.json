{
  "name": "ai-recruit",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "worker": "nest start --entryFile main-worker",
    "worker:dev": "nest start --entryFile main-worker --watch",
    "worker:prod": "node dist/src/main-worker",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "eslint": "eslint .",
    "prepare": "husky",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:load": "ts-node test/load-test/run.ts",
    "test:load:smoke": "npm run test:load -- --scenario smoke --concurrency 5 --duration 15",
    "test:load:stress": "bash test/load-test/run-profiles.sh stress",
    "test:load:1k": "bash test/load-test/run-profiles.sh 1k",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun drizzle/seed/index.ts",
    "db:seed:exam": "bun drizzle/seed/exam-seed.ts",
    "db:seed:exam-questions": "bun drizzle/seed/add-exam-questions.ts",
    "db:studio": "drizzle-kit studio",
    "casbin:init": "ts-node casbin_rule.config.ts init",
    "casbin:clear": "ts-node casbin_rule.config.ts clear",
    "casbin:verify": "ts-node casbin_rule.config.ts verify",
    "casbin:list": "ts-node casbin_rule.config.ts list",
    "casbin:migrate": "ts-node migrate-casbin.ts",
    "swagger:json": "node scripts/fetch-swagger-json.js",
    "swagger:json:generate": "ts-node -r tsconfig-paths/register scripts/generate-swagger-json.ts",
    "sync:firebase-identities": "ts-node -r tsconfig-paths/register scripts/sync-firebase-user-identities.ts",
    "create:system-user": "ts-node -r tsconfig-paths/register scripts/9.create-system-user/create-system-user.ts",
    "blog:backfill-locales": "ts-node -r tsconfig-paths/register scripts/backfill-blog-post-locales.ts"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint",
      "prettier --write"
    ]
  },
