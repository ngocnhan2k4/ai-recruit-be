    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.44.5",
    "drizzle-seed": "^0.3.1",
    "firebase-admin": "^13.5.0",
    "fuzzball": "^2.2.3",
    "ioredis": "^5.8.0",
    "keyv": "^5.6.0",
    "lodash": "^4.17.21",
    "mammoth": "^1.11.0",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
